---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPublishedPosts } from '../lib/blog';

const posts = await getPublishedPosts();
const featuredPosts = posts.slice(0, 2);
const latestPosts = posts.slice(0, 3);
const interests = [
  {
    title: 'LLM Reasoning',
    description:
      'How language models form intermediate steps, recover from mistakes, and handle ambiguous instructions.',
  },
  {
    title: 'World Models',
    description:
      'Representations that help systems predict, plan, and reason beyond surface text patterns.',
  },
  {
    title: 'Long-Context AI',
    description:
      'What changes when models must use thousands of tokens without losing the important signal.',
  },
  {
    title: 'AGI',
    description:
      'Careful notes on general intelligence, agency, learning, and evaluation.',
  },
  {
    title: 'AI Safety',
    description:
      'Robustness, alignment pressure, failure modes, and the practical risks of capable systems.',
  },
  {
    title: 'Research Notes',
    description:
      'Paper reviews, experiment logs, and explanations written while ideas are still forming.',
  },
];
---

<BaseLayout
  title="Signal in the Context"
  description="Notes on LLMs, world models, reasoning, and AGI by Priyansh Sarvaiya."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">AI research notebook</p>
      <h1>Signal in the Context</h1>
      <p class="hero-tagline">
        Notes on LLMs, world models, reasoning, and AGI.
      </p>
      <div class="hero-copy">
        <p>
          I write about AI, LLMs, world models, AGI, and the research questions
          behind intelligent systems.
        </p>
        <p>
          Currently exploring how language models reason when context becomes
          noisy, long, or misleading.
        </p>
      </div>
      <div class="button-row">
        <a class="button button-primary" href="/blog/">Read the blog</a>
        <a class="button button-secondary" href="/about/">About me</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Featured</p>
        <h2>Featured posts</h2>
      </div>
      <div class="post-grid two-column">
        {featuredPosts.map((post) => <BlogCard post={post} featured />)}
      </div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Research map</p>
        <h2>Research interests</h2>
      </div>
      <div class="interest-grid">
        {
          interests.map((interest) => (
            <article class="interest-card">
              <h3>{interest.title}</h3>
              <p>{interest.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header section-header-with-link">
        <div>
          <p class="eyebrow">Recently published</p>
          <h2>Latest posts</h2>
        </div>
        <a class="text-link" href="/blog/">All posts</a>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
